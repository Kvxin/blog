---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getLocale, localePath, ui } from '../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const t = ui[locale];

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang={locale}>
	<head>
		<BaseHead title={`${title} — ${t.blog}`} description={description} />
		<style>
			.swiss-article-main {
				max-width: 1140px;
				margin: 0 auto;
				padding: 40px 24px;
			}

			.article-masthead {
				border-bottom: 3px solid var(--swiss-black);
				padding-bottom: 32px;
				margin-bottom: 48px;
			}

			.masthead-meta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 20px;
				font-size: 12px;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				border-bottom: 1px solid var(--swiss-border-light);
				padding-bottom: 12px;
				margin-bottom: 24px;
			}

			.meta-date {
				color: var(--swiss-red);
				font-weight: 800;
			}

			.meta-revised {
				color: var(--swiss-gray);
				font-weight: 700;
			}

			.article-title {
				font-size: clamp(32px, 5.5vw, 56px);
				font-weight: 900;
				line-height: 1.05;
				letter-spacing: -0.03em;
				margin-bottom: 16px;
				word-break: break-word;
			}

			.article-lead {
				font-size: clamp(16px, 2vw, 19px);
				line-height: 1.6;
				color: #444444;
				margin-bottom: 0;
				font-weight: 500;
			}

			.article-hero-box {
				border: 1.5px solid var(--swiss-black);
				margin-bottom: 40px;
				background: #000;
			}

			.hero-img {
				width: 100%;
				height: auto;
				display: block;
			}

			.article-content-container {
				max-width: 820px;
				margin: 0 auto;
			}

			.article-prose {
				font-size: 17px;
				line-height: 1.75;
				color: #111111;
			}

			.article-prose :global(h2) {
				font-size: 24px;
				font-weight: 800;
				letter-spacing: -0.02em;
				border-bottom: 1.5px solid var(--swiss-black);
				padding-bottom: 8px;
				margin-top: 2.5rem;
				margin-bottom: 1rem;
			}

			.article-prose :global(h3) {
				font-size: 20px;
				font-weight: 800;
				letter-spacing: -0.02em;
				margin-top: 2rem;
				margin-bottom: 0.75rem;
			}

			.article-prose :global(p) {
				margin-bottom: 1.4em;
			}

			.article-prose :global(ul), .article-prose :global(ol) {
				margin: 1.25em 0;
				padding-left: 1.5rem;
			}

			.article-prose :global(li) {
				margin-bottom: 0.5em;
			}

			.article-bottom-nav {
				margin-top: 48px;
				padding-top: 24px;
				border-top: 2px solid var(--swiss-black);
			}

			.back-btn {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 10px 20px;
				background: var(--swiss-black);
				color: #ffffff;
				font-size: 12px;
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				text-decoration: none;
				border: 2px solid var(--swiss-black);
				transition: background-color 0.15s ease, border-color 0.15s ease;
			}

			.back-btn:hover {
				background: var(--swiss-red);
				border-color: var(--swiss-red);
				color: #ffffff;
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="swiss-article-main">
			<article class="swiss-article">
				<!-- Masthead / Article Title Bar -->
				<header class="article-masthead">
					<div class="masthead-meta-row">
						<span class="meta-date">
							<FormattedDate date={pubDate} />
						</span>
						{updatedDate && (
							<span class="meta-revised">
								{locale === 'zh-cn' ? '更新于: ' : 'Updated: '}
								<FormattedDate date={updatedDate} />
							</span>
						)}
					</div>

					<h1 class="article-title">{title}</h1>
					{description && <p class="article-lead">{description}</p>}
				</header>

				<!-- Hero Image Frame -->
				{heroImage && (
					<div class="article-hero-box">
						<Image width={960} height={480} src={heroImage} alt="" class="hero-img" />
					</div>
				)}

				<!-- Article Body -->
				<div class="article-content-container">
					<div class="article-prose">
						<slot />
					</div>

					<nav class="article-bottom-nav">
						<a href={localePath('/blog', locale)} class="back-btn">
							&larr; {locale === 'zh-cn' ? '返回文章列表' : 'RETURN TO ARTICLES'}
						</a>
					</nav>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
