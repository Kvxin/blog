---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { getCollection } from 'astro:content';
import { getEntryLocale, getLocale, languages, localePath, stripLocale, ui } from '../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const t = ui[locale];
const pathname = stripLocale(Astro.url.pathname);
const postSlug = pathname.match(/^\/blog\/(.+?)\/?$/)?.[1];
const availableLocales = postSlug
	? new Set((await getCollection('blog', (post) => post.data.translationKey === decodeURIComponent(postSlug))).map(getEntryLocale))
	: new Set(Object.keys(languages));
---

<header class="swiss-header">
	<nav class="swiss-nav">
		<div class="nav-left">
			<a href={localePath("/", locale)} class="swiss-nav-logo">
				<span class="logo-text">{SITE_TITLE}</span>
			</a>
			<div class="internal-links">
				<HeaderLink href={localePath('/', locale)}>{t.home}</HeaderLink>
				<HeaderLink href={localePath('/blog', locale)}>{t.blog}</HeaderLink>
				<HeaderLink href={localePath('/moments', locale)}>{t.momentsTitle}</HeaderLink>
				<HeaderLink href={localePath('/about', locale)}>{t.about}</HeaderLink>
			</div>
		</div>

		<div class="nav-right">
			<!-- 参考线按钮已删除/注释 -->
			<!--
			<button id="grid-toggle-btn" class="grid-toggle-btn" type="button" aria-label="Toggle Grid">
				<span class="icon">📐</span>
				<span class="btn-text">GRID</span>
			</button>
			-->

			<div class="language-links" aria-label={t.language}>
				{Object.entries(languages).filter(([code]) => availableLocales.has(code)).map(([code, name]) => (
					<a
						href={localePath(pathname, code)}
						hreflang={code}
						lang={code}
						aria-current={code === locale ? 'page' : undefined}
						class:list={['lang-pill', { active: code === locale }]}
					>
						{name}
					</a>
				))}
			</div>

			<div class="social-links">
				<a href="https://github.com/Kvxin" target="_blank" rel="noopener noreferrer" title="Kvxin (Kvxin)" aria-label="Kvxin (Kvxin)">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
						<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
					</svg>
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	.swiss-header {
		background: #ffffff;
		border-bottom: 3px solid var(--swiss-black);
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.swiss-nav {
		max-width: 1140px;
		margin: 0 auto;
		padding: 14px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
	}

	.nav-left {
		display: flex;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
	}

	.swiss-nav-logo {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		color: var(--swiss-black);
	}

	.logo-text {
		font-size: 17px;
		font-weight: 900;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 4px;
		flex-wrap: wrap;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.language-links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.lang-pill {
		padding: 4px 8px;
		font-size: 11px;
		font-weight: 700;
		text-decoration: none;
		color: var(--swiss-black);
		border: 1px solid var(--swiss-black);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		background: #ffffff;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.lang-pill:hover {
		background: var(--swiss-light-gray);
		color: var(--swiss-red);
	}

	.lang-pill.active {
		background: var(--swiss-black);
		color: #ffffff;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.social-links a {
		color: var(--swiss-black);
		display: flex;
		align-items: center;
		padding: 4px;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.social-links a:hover {
		color: var(--swiss-red);
	}
</style>
