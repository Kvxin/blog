---
import { SITE_TITLE } from '../consts';
import { getLocale, localePath, ui } from '../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const t = ui[locale];
const today = new Date();
---

<footer class="swiss-footer">
	<div class="swiss-footer-container">
		<div class="footer-grid">
			<!-- Col 1: Identity & Description -->
			<div class="footer-col col-brand">
				<div class="brand-line">
					<span class="brand-title">{SITE_TITLE}</span>
				</div>
				<p class="brand-desc">
					{locale === 'zh-cn' 
						? '记录技术探索、产品思考与生活片段的个人博客。' 
						: 'A personal space for engineering notes, design thoughts, and life moments.'}
				</p>
			</div>

			<!-- Col 2: Navigation Map -->
			<div class="footer-col">
				<div class="col-header">
					<span>{locale === 'zh-cn' ? '导航' : 'SITEMAP'}</span>
				</div>
				<ul class="col-links">
					<li><a href={localePath('/', locale)}>{t.home}</a></li>
					<li><a href={localePath('/blog', locale)}>{t.blog}</a></li>
					<li><a href={localePath('/moments', locale)}>{t.momentsTitle}</a></li>
					<li><a href={localePath('/about', locale)}>{t.about}</a></li>
					<li><a href={new URL('rss.xml', Astro.site).toString()} target="_blank">RSS FEED</a></li>
				</ul>
			</div>

			<!-- Col 3: Network & Links -->
			<div class="footer-col">
				<div class="col-header">
					<span>{locale === 'zh-cn' ? '链接' : 'NETWORK'}</span>
				</div>
				<ul class="col-links">
					<li><a href="https://github.com/Kvxin" target="_blank" rel="noopener noreferrer">Kvxin (Kvxin)</a></li>
					<li><a href="https://space.bilibili.com/36729870" target="_blank" rel="noopener noreferrer">bilibili</a></li>
				</ul>
			</div>
		</div>

		<!-- Bottom Legal Bar -->
		<div class="footer-bottom">
			<div class="copyright">
				&copy; {today.getFullYear()} {SITE_TITLE}. {t.footer}
			</div>
		</div>
	</div>
</footer>

<style>
	.swiss-footer {
		background: #ffffff;
		border-top: 3px solid var(--swiss-black);
		margin-top: 60px;
		color: var(--swiss-black);
		font-family: var(--font-swiss);
	}

	.swiss-footer-container {
		max-width: 1140px;
		margin: 0 auto;
		padding: 48px 24px 36px 24px;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 48px;
		padding-bottom: 40px;
		border-bottom: 1px solid var(--swiss-border-light);
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}

	.brand-line {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 12px;
	}

	.brand-title {
		font-size: 16px;
		font-weight: 900;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.brand-desc {
		font-size: 13.5px;
		line-height: 1.6;
		color: #444444;
		max-width: 440px;
		margin-bottom: 0;
	}

	.col-header {
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		display: flex;
		justify-content: space-between;
		border-bottom: 1.5px solid var(--swiss-black);
		padding-bottom: 8px;
		margin-bottom: 14px;
	}

	.col-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.col-links a {
		font-size: 13px;
		font-weight: 600;
		color: var(--swiss-black);
		text-decoration: none;
		transition: color 0.15s ease, transform 0.15s ease;
		display: inline-block;
	}

	.col-links a:hover {
		color: var(--swiss-red);
		transform: translateX(3px);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 24px;
		font-size: 12px;
		font-weight: 600;
		color: var(--swiss-gray);
		flex-wrap: wrap;
		gap: 12px;
	}
</style>
