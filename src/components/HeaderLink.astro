---
import type { HTMLAttributes } from 'astro/types';
import { locales } from '../i18n/ui';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '');
const linkPath = typeof href === 'string' ? href.replace(/\/$/, '') : '';
const homePaths = [import.meta.env.BASE_URL.replace(/\/$/, ''), ...locales.map((locale) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${locale}`)];
const isActive = pathname === linkPath || (!homePaths.includes(linkPath) && pathname.startsWith(`${linkPath}/`));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-flex;
		align-items: center;
		padding: 8px 12px;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--swiss-black);
		position: relative;
		border: 1px solid transparent;
		transition: background-color 0.12s ease, color 0.12s ease;
	}
	a:hover {
		color: var(--swiss-red);
		background-color: var(--swiss-light-gray);
	}
	a.active {
		background-color: var(--swiss-black);
		color: #ffffff;
	}
	a.active:hover {
		background-color: var(--swiss-red);
		color: #ffffff;
	}
</style>
