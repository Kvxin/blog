{
  "name": "@blog/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:media": "node --test test/media.test.cjs",
    "test:ai": "node --test test/ai.test.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "admin:init": "node dist/modules/auth/init-admin.js",
    "media:import": "node dist/modules/media/import-project-images.js",
    "media:repair-names": "node dist/modules/media/repair-filenames.js"
  },
  "dependencies": {
    "@blog/contracts": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.7",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "undici": "^7.16.0",
    "ipaddr.js": "^2.2.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@blog/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "typescript": "^5.9.3"
  }
}
