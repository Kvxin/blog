# Copy to .env and replace the password. Never commit .env.
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://blog:replace-with-a-random-password@127.0.0.1:5432/blog?schema=public
API_HOST=127.0.0.1
API_PORT=3000
UPLOAD_DIR=/www/blog-data/uploads
ADMIN_ORIGIN=https://kvxin.top
# Set true with HTTPS; false is only for the current HTTP testing setup.
SESSION_SECURE=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_NAME=管理员

# Qiniu credentials remain server-only. Never use a VITE_/PUBLIC_ prefix.
QI_NIU_AK=replace-with-your-access-key
QI_NIU_SK=replace-with-your-secret-key
QI_NIU_BUCKET=ai-dramas
QI_NIU_REGION=z2
QI_NIU_DOMAIN=https://cdn.kvxin.top
QI_NIU_PREFIX=blog/
# Optional, only if direct access is unavailable on the API server.
QI_NIU_PROXY=http://127.0.0.1:7890
PUBLISH_ROOT=/www/blog-data
BLOG_SITE_URL=https://kvxin.top
BLOG_BASE_PATH=/
# Server-only AES-256-GCM key, 64 hexadecimal characters. Not an AI provider key.
AI_ENCRYPTION_KEY=replace-with-64-random-hex-characters
