[Unit]
Description=Blog NestJS API
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=blog-api
Group=blog-api
WorkingDirectory=/workspace/blog/apps/api
Environment=NODE_ENV=production
EnvironmentFile=/workspace/blog/.env
ExecStart=/usr/local/bin/blog-node dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/blog-data/uploads
ReadWritePaths=/www/blog-data/builds /www/blog-data/releases /www/blog-data/publish.lock
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
